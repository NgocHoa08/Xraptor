# ===================================================
# XRAPTOR BACKEND ENVIRONMENT VARIABLES
# Copy file này thành .env (chạy local) hoặc dán vào Vercel -> Settings -> Environment Variables
# ===================================================

# 1. Supabase (bỏ trống để chạy Local SQLite tự động)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=xraptor-uploads

# 2. Khóa ký token đăng nhập & xác thực chữ ký thanh toán (chuỗi bí mật > 24 ký tự)
ADMIN_JWT_SECRET=xraptor-pickleball-super-secret-2026
PAYMENT_SIGNING_SECRET=xraptor-payment-signing-secret-2026

# 3. Cổng chạy Backend Local & URL Frontend
PORT=4000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# 4. Cấu hình VietQR chuyển khoản ngân hàng
VIETQR_BANK_CODE=MB
VIETQR_BANK_NAME=MB Bank (Ngân hàng Quân Đội)
VIETQR_ACCOUNT_NO=0949331386
VIETQR_ACCOUNT_NAME=XRAPTOR PICKLEBALL VIETNAM

# 5. Cấu hình Cổng thanh toán VNPay (Sandbox / Production)
# Bỏ trống 2 biến bên dưới để dùng Cổng VNPay Sandbox Mô phỏng tích hợp sẵn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/payments/vnpay/return
