# ===================================================
# XRAPTOR BACKEND ENVIRONMENT VARIABLES
# Copy file này thành .env (chạy local) hoặc dán vào Vercel -> Settings -> Environment Variables
# ===================================================

# 1. Supabase (lấy trong Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=xraptor-uploads

# 2. Khóa ký token đăng nhập Admin (đặt chuỗi bí mật bất kỳ dài > 24 ký tự)
ADMIN_JWT_SECRET=xraptor-pickleball-super-secret-2026

# 3. Cổng chạy Backend Local (mặc định 4000)
PORT=4000
